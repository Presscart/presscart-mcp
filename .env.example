PRESSCART_API_URL=https://api.presscart.com
MCP_HOST=0.0.0.0
MCP_PORT=8787
# On Railway, the platform-provided PORT is used automatically.
#
# Recommended for hosted OAuth on Railway so issued OAuth credentials survive deploys/restarts:
# MCP_OAUTH_SIGNING_SECRET=replace-with-a-random-32+-char-secret

# Optional local stdio fallback only:
# PRESSCART_API_TOKEN=pc_...
# PRESSCART_PROFILE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
